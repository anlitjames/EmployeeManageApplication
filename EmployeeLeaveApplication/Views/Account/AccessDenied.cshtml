@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-danger p-4">
            <div class="card-body">
                <h1 class="text-danger display-3"><i class="bi bi-slash-circle"></i></h1>
                <h2 class="text-danger fw-bold">Access Denied</h2>
                <p class="lead text-muted mt-3">
                    You do not have permission to access this resource. Please contact your system administrator if you believe this is an error.
                </p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary me-2">Back to Dashboard</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Login with Different Account</a>
                </div>
            </div>
        </div>
    </div>
</div>
