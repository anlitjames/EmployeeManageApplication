@model EmployeeLeaveApplication.ViewModels.EmployeeCreateViewModel
@{
    ViewData["Title"] = "Add Employee";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus"></i> Add New Employee</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="EmployeeCode" class="form-label fw-semibold"></label>
                            <input asp-for="EmployeeCode" class="form-control text-uppercase" placeholder="e.g. EMP011" />
                            <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EmployeeName" class="form-label fw-semibold"></label>
                            <input asp-for="EmployeeName" class="form-control" placeholder="Full Name" />
                            <span asp-validation-for="EmployeeName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="employee@company.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label fw-semibold"></label>
                            <select asp-for="DepartmentId" asp-items="Model.DepartmentList" class="form-select">
                                <option value="">-- Select Department --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfJoining" class="form-label fw-semibold"></label>
                            <input asp-for="DateOfJoining" type="date" class="form-control" />
                            <span asp-validation-for="DateOfJoining" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ReportingManagerId" class="form-label fw-semibold"></label>
                            <select asp-for="ReportingManagerId" asp-items="Model.ManagerList" class="form-select">
                                <option value="">-- None (Reports to No One) --</option>
                            </select>
                            <span asp-validation-for="ReportingManagerId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Save Employee</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
