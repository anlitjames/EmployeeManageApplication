@model EmployeeLeaveApplication.ViewModels.EmployeeDetailsViewModel
@{
    ViewData["Title"] = "Employee Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-badge"></i> Employee Details</h4>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light btn-sm"><i class="bi bi-pencil"></i> Edit</a>
                    <a asp-action="Index" class="btn btn-outline-light btn-sm ms-1">Back to List</a>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Employee Code:</div>
                    <div class="col-sm-8 fw-bold">@Model.EmployeeCode</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Full Name:</div>
                    <div class="col-sm-8">@Model.EmployeeName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Email:</div>
                    <div class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Department:</div>
                    <div class="col-sm-8"><span class="badge bg-secondary">@Model.DepartmentName</span></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Date of Joining:</div>
                    <div class="col-sm-8">@Model.DateOfJoining.ToString("MMMM dd, yyyy")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Reporting Manager:</div>
                    <div class="col-sm-8">@(Model.ReportingManagerName ?? "None")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Status:</div>
                    <div class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-semibold">Created Date:</div>
                    <div class="col-sm-8 text-muted">@Model.CreatedDate.ToString("g")</div>
                </div>
                @if (Model.ModifiedDate.HasValue)
                {
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted fw-semibold">Last Modified:</div>
                        <div class="col-sm-8 text-muted">@Model.ModifiedDate.Value.ToString("g")</div>
                    </div>
                }

                <div class="mt-4 pt-3 border-top">
                    <h5 class="fw-bold"><i class="bi bi-people"></i> Direct Subordinates (@Model.Subordinates.Count)</h5>
                    @if (Model.Subordinates.Any())
                    {
                        <ul class="list-group list-group-flush mt-2">
                            @foreach (var sub in Model.Subordinates)
                            {
                                <li class="list-group-item">@sub</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small">No subordinates report directly to this employee.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
