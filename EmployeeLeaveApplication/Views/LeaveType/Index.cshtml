@model List<EmployeeLeaveApplication.ViewModels.LeaveTypeItemViewModel>
@{
    ViewData["Title"] = "Leave Types";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-calendar-check"></i> Leave Type Management</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add New Leave Type</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Leave Type</th>
                        <th>Description</th>
                        <th class="text-center">Annual Allocation</th>
                        <th class="text-center">Carry Forward Allowed</th>
                        <th class="text-center">Max Carry Forward</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No leave types configured.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var lt in Model)
                        {
                            <tr>
                                <td class="fw-bold">@lt.LeaveTypeName</td>
                                <td class="text-muted">@(lt.Description ?? "—")</td>
                                <td class="text-center"><span class="badge bg-primary fs-6">@lt.AnnualAllocation.ToString("0.##") days</span></td>
                                <td class="text-center">
                                    @if (lt.CarryForwardAllowed)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-lg"></i> Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-x-lg"></i> No</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @(lt.CarryForwardAllowed ? lt.MaxCarryForwardDays.ToString("0.##") + " days" : "0 days")
                                </td>
                                <td class="text-center">
                                    @if (lt.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@lt.Id" class="btn btn-outline-primary" title="Edit">Edit</a>
                                        <form asp-action="ToggleStatus" asp-route-id="@lt.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to change the status of this leave type?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(lt.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                                @(lt.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
