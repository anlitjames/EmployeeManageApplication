@model EmployeeLeaveApplication.ViewModels.LeaveApprovalListViewModel
@{
    ViewData["Title"] = "Leave Approvals";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold"><i class="bi bi-check2-square"></i> Pending Leave Approvals</h2>
        <p class="text-muted mb-0">Role: <span class="badge bg-info text-dark">@Model.UserRole</span></p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Leave Type</th>
                        <th>From Date</th>
                        <th>To Date</th>
                        <th class="text-center">Days</th>
                        <th class="text-center">Available Balance</th>
                        <th>Reason</th>
                        <th>Applied Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PendingApplications.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                No pending leave applications require your approval at this time.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.PendingApplications)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.EmployeeName</div>
                                    <small class="text-muted">@item.EmployeeCode</small>
                                </td>
                                <td><span class="badge bg-secondary">@item.DepartmentName</span></td>
                                <td><span class="badge bg-primary">@item.LeaveTypeName</span></td>
                                <td>@item.FromDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.ToDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center fw-bold text-primary">@item.NumberOfDays.ToString("0.##")</td>
                                <td class="text-center">
                                    @if (item.AvailableBalance < item.NumberOfDays)
                                    {
                                        <span class="badge bg-danger" title="Requested days exceed balance!">@item.AvailableBalance.ToString("0.##") days</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@item.AvailableBalance.ToString("0.##") days</span>
                                    }
                                </td>
                                <td class="text-truncate" style="max-width: 220px;" title="@item.Reason">@item.Reason</td>
                                <td>@item.AppliedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to approve this application for @item.NumberOfDays day(s)?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success" @(item.AvailableBalance < item.NumberOfDays ? "disabled" : "") title="Approve application">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-danger ms-1" data-bs-toggle="modal" data-bs-target="#rejectModal" data-app-id="@item.Id" data-emp-name="@item.EmployeeName">
                                            <i class="bi bi-x-lg"></i> Reject
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Rejection Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ApplicationId" id="modalApplicationId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="rejectModalLabel"><i class="bi bi-x-circle"></i> Reject Leave Application</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>You are about to reject the leave application for <strong id="modalEmpName"></strong>.</p>
                    <div class="mb-3">
                        <label for="modalRejectionRemarks" class="form-label fw-semibold">Rejection Remarks (Mandatory):</label>
                        <textarea class="form-control" name="RejectionRemarks" id="modalRejectionRemarks" rows="3" required placeholder="Please provide specific reason for rejection..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg"></i> Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var rejectModal = document.getElementById('rejectModal');
        if (rejectModal) {
            rejectModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var appId = button.getAttribute('data-app-id');
                var empName = button.getAttribute('data-emp-name');

                document.getElementById('modalApplicationId').value = appId;
                document.getElementById('modalEmpName').textContent = empName;
                document.getElementById('modalRejectionRemarks').value = '';
            });
        }
    </script>
}
